# Configuração do M1 (motor de execução) do Projeto Arandu.
#
# O código lê as seções [limites], [limites_diff] e [servidor].
# As outras seções registram o papel do M1 na equipe: leia antes de mudar algo.

[modulo]
nome = M1 - Motor de execução + ferramentas (MCP)
papel = Executar código Python num sandbox e relatar o que aconteceu, sem interpretar.
entrega = executar, trace, rodar_suite, diff_comportamental (Contrato A, ver CONTRATO_A.md)

[fronteiras]
# O que é de cada módulo. O M1 não faz tarefa de outro módulo.
m1 = sandbox, execução, trace, suíte de testes, comparação aluno x referência
m2 = banco de bugs: ingestão do Refactory, rótulos ProgMiscon, laço Construtor-Validador, trajetórias, dificuldade
m3 = Treinador: hipóteses, escolha da entrada, conclusão sobre as hipóteses, dicas, modelo do aluno, Verificador
m4 = interface da sessão, painéis, métricas, pitch
hipoteses = São do M3. O M3 escolhe a entrada a partir das hipóteses dele e a envia ao M1; o M1 roda o código
    do aluno e o de referência com essa entrada e devolve divergiu, as duas saídas e o trace dos dois.
    Quem analisa e conclui qual hipótese é verdadeira é o M3.

[regras]
modular = Cada ferramenta é uma função independente, usável em Python, por MCP e por REST.
contrato = Mudar o formato de entrada ou saída é decisão da equipe: atualizar CONTRATO_A.md e arandu_motor/contrato.py.
trace_sempre = diff_comportamental devolve sempre o trace dos dois códigos, com ou sem hipótese do M3.

[limites]
# Por execução.
tempo_s = 5
max_linhas = 3000000
max_saida = 64000
max_passos = 500
memoria_mb = 512

[limites_diff]
# No diff_comportamental: quantos passos do trace de cada código são gravados e devolvidos.
max_passos = 1000
max_linhas = 200000

[servidor]
host = 127.0.0.1
porta = 8000
